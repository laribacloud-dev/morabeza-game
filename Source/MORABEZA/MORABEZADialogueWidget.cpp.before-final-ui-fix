#include "MORABEZADialogueWidget.h"

#include "Blueprint/WidgetTree.h"

#include "Components/CanvasPanel.h"
#include "Components/CanvasPanelSlot.h"
#include "Components/Border.h"
#include "Components/VerticalBox.h"
#include "Components/VerticalBoxSlot.h"
#include "Components/TextBlock.h"

UMORABEZADialogueWidget::UMORABEZADialogueWidget(
    const FObjectInitializer& ObjectInitializer
)
    : Super(ObjectInitializer)
{
}

void UMORABEZADialogueWidget::NativeConstruct()
{
    Super::NativeConstruct();

    UE_LOG(
        LogTemp,
        Warning,
        TEXT("==================================================")
    );

    UE_LOG(
        LogTemp,
        Warning,
        TEXT("MORABEZA DIALOGUE WIDGET: NativeConstruct")
    );

    /*
     * ============================================================
     * ROOT
     * ============================================================
     */

    RootCanvas =
        WidgetTree->ConstructWidget<UCanvasPanel>(
            UCanvasPanel::StaticClass(),
            TEXT("DialogueRootCanvas")
        );

    if (!RootCanvas)
    {
        UE_LOG(
            LogTemp,
            Error,
            TEXT("MORABEZA DIALOGUE WIDGET: FAILED ROOT CANVAS")
        );

        return;
    }

    WidgetTree->RootWidget = RootCanvas;

    /*
     * ============================================================
     * DIALOGUE PANEL
     * ============================================================
     */

    DialoguePanel =
        WidgetTree->ConstructWidget<UBorder>(
            UBorder::StaticClass(),
            TEXT("DialoguePanel")
        );

    if (!DialoguePanel)
    {
        UE_LOG(
            LogTemp,
            Error,
            TEXT("MORABEZA DIALOGUE WIDGET: FAILED PANEL")
        );

        return;
    }

    RootCanvas->AddChild(DialoguePanel);

    UCanvasPanelSlot* PanelSlot =
        Cast<UCanvasPanelSlot>(DialoguePanel->Slot);

    if (!PanelSlot)
    {
        UE_LOG(
            LogTemp,
            Error,
            TEXT("MORABEZA DIALOGUE WIDGET: FAILED PANEL SLOT")
        );

        return;
    }

    /*
     * ============================================================
     * PANEL LAYOUT
     * ============================================================
     *
     * Anchored to the bottom-center of the widget viewport.
     */

    PanelSlot->SetAnchors(
        FAnchors(
            0.5f,
            1.0f,
            0.5f,
            1.0f
        )
    );

    PanelSlot->SetAlignment(
        FVector2D(
            0.5f,
            1.0f
        )
    );

    PanelSlot->SetPosition(
        FVector2D(
            0.0f,
            -60.0f
        )
    );

    PanelSlot->SetSize(
        FVector2D(
            1100.0f,
            300.0f
        )
    );

    /*
     * ============================================================
     * PANEL STYLE
     * ============================================================
     */

    DialoguePanel->SetBrushColor(
        FLinearColor(
            0.005f,
            0.005f,
            0.005f,
            0.97f
        )
    );

    DialoguePanel->SetPadding(
        FMargin(
            45.0f,
            35.0f,
            45.0f,
            35.0f
        )
    );

    /*
     * ============================================================
     * CONTENT
     * ============================================================
     */

    DialogueContent =
        WidgetTree->ConstructWidget<UVerticalBox>(
            UVerticalBox::StaticClass(),
            TEXT("DialogueContent")
        );

    DialoguePanel->SetContent(
        DialogueContent
    );

    /*
     * ============================================================
     * SPEAKER
     * ============================================================
     */

    SpeakerText =
        WidgetTree->ConstructWidget<UTextBlock>(
            UTextBlock::StaticClass(),
            TEXT("SpeakerText")
        );

    SpeakerText->SetText(
        FText::FromString(
            TEXT("TEST CONTACT")
        )
    );

    SpeakerText->SetColorAndOpacity(
        FSlateColor(
            FLinearColor(
                1.0f,
                0.75f,
                0.10f,
                1.0f
            )
        )
    );

    FSlateFontInfo SpeakerFont =
        SpeakerText->GetFont();

    SpeakerFont.Size = 32;

    SpeakerText->SetFont(
        SpeakerFont
    );

    SpeakerText->SetAutoWrapText(true);

    UVerticalBoxSlot* SpeakerSlot =
        DialogueContent->AddChildToVerticalBox(
            SpeakerText
        );

    if (SpeakerSlot)
    {
        SpeakerSlot->SetPadding(
            FMargin(
                0.0f,
                0.0f,
                0.0f,
                20.0f
            )
        );
    }

    /*
     * ============================================================
     * DIALOGUE TEXT
     * ============================================================
     */

    DialogueText =
        WidgetTree->ConstructWidget<UTextBlock>(
            UTextBlock::StaticClass(),
            TEXT("DialogueText")
        );

    DialogueText->SetText(
        FText::FromString(
            TEXT("BEM-VINDO A MORABEZA.")
        )
    );

    DialogueText->SetColorAndOpacity(
        FSlateColor(
            FLinearColor(
                1.0f,
                1.0f,
                1.0f,
                1.0f
            )
        )
    );

    FSlateFontInfo DialogueFont =
        DialogueText->GetFont();

    DialogueFont.Size = 28;

    DialogueText->SetFont(
        DialogueFont
    );

    DialogueText->SetAutoWrapText(true);

    DialogueText->SetWrappingPolicy(
        ETextWrappingPolicy::AllowPerCharacterWrapping
    );

    DialogueContent->AddChildToVerticalBox(
        DialogueText
    );

    /*
     * ============================================================
     * INITIAL STATE
     * ============================================================
     */

    SetVisibility(
        ESlateVisibility::Collapsed
    );

    SetRenderOpacity(1.0f);

    UE_LOG(
        LogTemp,
        Warning,
        TEXT("MORABEZA DIALOGUE WIDGET: UI constructed successfully")
    );

    UE_LOG(
        LogTemp,
        Warning,
        TEXT("MORABEZA DIALOGUE WIDGET: Full viewport root active")
    );

    UE_LOG(
        LogTemp,
        Warning,
        TEXT("MORABEZA DIALOGUE WIDGET: Panel = 1100 x 300")
    );

    UE_LOG(
        LogTemp,
        Warning,
        TEXT("==================================================")
    );
}

void UMORABEZADialogueWidget::ShowDialogue(
    const FText& SpeakerName,
    const FText& InDialogueText
)
{
    UE_LOG(
        LogTemp,
        Warning,
        TEXT("==================================================")
    );

    UE_LOG(
        LogTemp,
        Warning,
        TEXT("MORABEZA DIALOGUE WIDGET: ShowDialogue CALLED")
    );

    if (!RootCanvas ||
        !DialoguePanel ||
        !DialogueContent ||
        !SpeakerText ||
        !DialogueText)
    {
        UE_LOG(
            LogTemp,
            Error,
            TEXT("MORABEZA DIALOGUE WIDGET: INVALID COMPONENT")
        );

        return;
    }

    /*
     * ============================================================
     * UPDATE TEXT
     * ============================================================
     */

    SpeakerText->SetText(
        SpeakerName
    );

    DialogueText->SetText(
        InDialogueText
    );

    /*
     * ============================================================
     * VISIBILITY
     * ============================================================
     */

    SetVisibility(
        ESlateVisibility::Visible
    );

    RootCanvas->SetVisibility(
        ESlateVisibility::Visible
    );

    DialoguePanel->SetVisibility(
        ESlateVisibility::Visible
    );

    DialogueContent->SetVisibility(
        ESlateVisibility::Visible
    );

    SpeakerText->SetVisibility(
        ESlateVisibility::Visible
    );

    DialogueText->SetVisibility(
        ESlateVisibility::Visible
    );

    SetRenderOpacity(1.0f);

    /*
     * ============================================================
     * FORCE LAYOUT
     * ============================================================
     */

    UCanvasPanelSlot* PanelSlot =
        Cast<UCanvasPanelSlot>(DialoguePanel->Slot);

    if (PanelSlot)
    {
        PanelSlot->SetAnchors(
            FAnchors(
                0.5f,
                1.0f,
                0.5f,
                1.0f
            )
        );

        PanelSlot->SetAlignment(
            FVector2D(
                0.5f,
                1.0f
            )
        );

        PanelSlot->SetPosition(
            FVector2D(
                0.0f,
                -60.0f
            )
        );

        PanelSlot->SetSize(
            FVector2D(
                1100.0f,
                300.0f
            )
        );
    }

    InvalidateLayoutAndVolatility();

    /*
     * ============================================================
     * DEBUG
     * ============================================================
     */

    UE_LOG(
        LogTemp,
        Warning,
        TEXT("MORABEZA DIALOGUE WIDGET: VISIBLE")
    );

    UE_LOG(
        LogTemp,
        Warning,
        TEXT(
            "MORABEZA DIALOGUE WIDGET: Speaker = %s"
        ),
        *SpeakerName.ToString()
    );

    UE_LOG(
        LogTemp,
        Warning,
        TEXT(
            "MORABEZA DIALOGUE WIDGET: Text = %s"
        ),
        *InDialogueText.ToString()
    );

    UE_LOG(
        LogTemp,
        Warning,
        TEXT(
            "MORABEZA DIALOGUE WIDGET: DISPLAYING DIALOGUE"
        )
    );

    UE_LOG(
        LogTemp,
        Warning,
        TEXT("==================================================")
    );
}

void UMORABEZADialogueWidget::HideDialogue()
{
    SetVisibility(
        ESlateVisibility::Collapsed
    );

    UE_LOG(
        LogTemp,
        Warning,
        TEXT("MORABEZA DIALOGUE WIDGET: HIDDEN")
    );
}
